# Web — put secrets in `.env.local` at the **repo root** (or `apps/web/.env.local`; root is loaded by next.config).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel project: grove-growth-together): https://grove-growth-together.vercel.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Both Clerk vars are required for middleware auth in production. For local `pnpm build` without keys, the app skips enforced auth.
# Local demo (/demo/start): set NODE_ENV=development, NEXT_PUBLIC_DEMO_MODE=true below, SUPABASE_* and SUPABASE_SERVICE_ROLE_KEY — seeds profile/goals + middleware onboarding step reads.
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback for older Supabase projects. Prefer publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker / server-side jobs (required for full local demo seed and demo middleware profile lookup)
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Use llama-3.1-8b-instant or llama-3.3-70b-versatile. Do not use llama-3.1-70b-versatile (decommissioned).
GROQ_MODEL=llama-3.1-8b-instant
# Optional: model for onboarding JSON routes only (/api/ai/profile, /api/ai/domain-weights). Falls back to GROQ_MODEL.
GROQ_ONBOARDING_MODEL=
# Google Calendar (Profile connect + Today busy overlay). Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
NUDGE_FROM_EMAIL=Grove <nudges@grove.local>
