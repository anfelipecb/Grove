# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel project: grove-growth-together): https://grove-growth-together.vercel.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Both Clerk vars are required for middleware auth in production. For local `pnpm build` without keys, the app skips enforced auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback for older Supabase projects. Prefer publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker / server-side jobs
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
RESEND_API_KEY=
NUDGE_FROM_EMAIL=Grove <nudges@grove.local>
